rules_version = '2';

// ⚠ Firebase allows ONE rules file per project. brb-website and brb-subscriptions
// carry their own copies — MERGE these blocks into the project's rules before
// running `firebase deploy --only firestore:rules`, or you will overwrite theirs.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/aclAdmins/$(request.auth.uid));
    }

    // A volunteer's doc id IS their lowercased email — see volunteerIdFor().
    function myVolunteerId() {
      return request.auth.token.email.lower();
    }

    match /aclAdmins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;                     // managed from the Firebase console
    }

    match /aclConfig/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /aclVolunteers/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // first-time uid link only, by the person whose email it is
        || (resource.data.uid == null
            && id == myVolunteerId()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uid', 'status', 'claimedAt']));
    }

    match /aclAvailability/{volunteerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || volunteerId == myVolunteerId();
    }

    match /aclAssignments/{slotId} {
      // A position is either untouched, or vacated by the person standing in it.
      function dropOk(k) {
        return request.resource.data.positions[k] == resource.data.positions[k]
            || (resource.data.positions[k] == myVolunteerId()
                && request.resource.data.positions[k] == null);
      }

      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // Four fixed keys, enumerated — rules have no loops.
        || (request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['positions', 'updatedAt'])
            && dropOk('front-left') && dropOk('front-right')
            && dropOk('back-left')  && dropOk('back-right'));
    }

    match /aclDropLog/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.volunteerId == myVolunteerId();
      allow update, delete: if false;
    }
  }
}
