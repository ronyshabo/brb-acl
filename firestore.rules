rules_version = '2';

// ⚠ Firebase allows ONE rules file per project (brb-coffee-dev), and the LIVE
// rules contain blocks that exist in no repo — bands, events, subscribers,
// baristas, scheduleUsers, schedules, and an isAdmin() of their own.
//
// DO NOT deploy this file. It is a reference copy of the brb-acl blocks only.
// To change the live rules, paste firestore-acl-blocks.rules into the console
// alongside what is already there.

service cloud.firestore {
  match /databases/{database}/documents {

    // These two come from the live rules and are assumed to exist:
    //   function isSignedIn() { return request.auth != null; }
    //   function isAdmin()    { ...token.admin, brbcafeatx@gmail.com... }

    function isAclAdmin() {
      return isAdmin()
          || (isSignedIn()
              && exists(/databases/$(database)/documents/aclAdmins/$(request.auth.uid)));
    }

    // A volunteer's doc id IS their lowercased email — the app relies on this.
    function myVolunteerId() {
      return request.auth.token.email.lower();
    }

    match /aclAdmins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;                    // managed from the Firebase console
    }

    match /aclConfig/{doc} {
      allow read: if isSignedIn();
      allow write: if isAclAdmin();
    }

    match /aclVolunteers/{id} {
      allow read: if isSignedIn();
      allow delete: if isAclAdmin();

      allow create: if isAclAdmin()
        || (id == myVolunteerId()
            && request.resource.data.email == id
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'active'
            && request.resource.data.keys().hasOnly([
                 'name', 'email', 'phone', 'status', 'uid',
                 'invitedAt', 'claimedAt', 'selfSignup', 'notes'
               ]));

      allow update: if isAclAdmin()
        // First-time uid link only, by the person whose email it is.
        // Check absence before value: reading a missing field errors, and an
        // erroring rule denies.
        || ((!('uid' in resource.data) || resource.data.uid == null)
            && id == myVolunteerId()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uid', 'status', 'claimedAt']));
    }

    match /aclAvailability/{volunteerId} {
      allow read: if isSignedIn();
      allow write: if isAclAdmin() || volunteerId == myVolunteerId();
    }

    match /aclAssignments/{slotId} {
      // A position is either untouched, or vacated by the person standing in it.
      function dropOk(k) {
        return request.resource.data.positions[k] == resource.data.positions[k]
            || (resource.data.positions[k] == myVolunteerId()
                && request.resource.data.positions[k] == null);
      }

      allow read: if isSignedIn();
      allow create, delete: if isAclAdmin();
      allow update: if isAclAdmin()
        // Four fixed keys, enumerated — rules have no loops.
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['positions', 'updatedAt'])
            && dropOk('front-left') && dropOk('front-right')
            && dropOk('back-left')  && dropOk('back-right'));
    }

    // Read-only view of brb-schedule's rota, so ACL admins can see who is
    // already committed at the shop on fest days. No write access.
    match /schedules/{id} {
      allow read: if isAclAdmin();
    }

    match /aclDropLog/{id} {
      allow read: if isAclAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.volunteerId == myVolunteerId();
      allow update, delete: if false;
    }

  }
}
