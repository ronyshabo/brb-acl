// ─────────────────────────────────────────────────────────────────────────────
// brb-acl rules — ADDITIVE.
//
// Paste this INSIDE your existing
//   match /databases/{database}/documents { ... }
// block. Do not remove anything already there.
//
// Reuses your existing isSignedIn() and isAdmin() helpers rather than
// redefining them — a second isAdmin() in the same scope is a duplicate
// function error and the deploy would be rejected.
//
// isAclAdmin() deliberately ORs two things:
//   * your existing isAdmin()  → brbcafeatx@gmail.com works immediately,
//                                no aclAdmins doc needed to bootstrap
//   * an aclAdmins/{uid} doc   → lets you add fest-only admins later
//                                without editing rules again
// ─────────────────────────────────────────────────────────────────────────────

    function isAclAdmin() {
      return isAdmin()
          || (isSignedIn()
              && exists(/databases/$(database)/documents/aclAdmins/$(request.auth.uid)));
    }

    // A volunteer's doc id IS their lowercased email — the app relies on this.
    function myVolunteerId() {
      return request.auth.token.email.lower();
    }

    match /aclAdmins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;                    // managed from the Firebase console
    }

    match /aclConfig/{doc} {
      allow read: if isSignedIn();
      allow write: if isAclAdmin();
    }

    match /aclVolunteers/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAclAdmin();
      allow update: if isAclAdmin()
        // First-time uid link only, by the person whose email it is.
        // `!('uid' in ...)` first: reading an absent field errors, and an
        // erroring rule denies — which would lock out any volunteer whose
        // doc was created by hand without a uid field.
        || ((!('uid' in resource.data) || resource.data.uid == null)
            && id == myVolunteerId()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uid', 'status', 'claimedAt']));
    }

    match /aclAvailability/{volunteerId} {
      allow read: if isSignedIn();
      allow write: if isAclAdmin() || volunteerId == myVolunteerId();
    }

    match /aclAssignments/{slotId} {
      // A position is either untouched, or vacated by the person standing in it.
      function dropOk(k) {
        return request.resource.data.positions[k] == resource.data.positions[k]
            || (resource.data.positions[k] == myVolunteerId()
                && request.resource.data.positions[k] == null);
      }

      allow read: if isSignedIn();
      allow create, delete: if isAclAdmin();
      allow update: if isAclAdmin()
        // Four fixed keys, enumerated — rules have no loops.
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['positions', 'updatedAt'])
            && dropOk('front-left') && dropOk('front-right')
            && dropOk('back-left')  && dropOk('back-right'));
    }

    match /aclDropLog/{id} {
      allow read: if isAclAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.volunteerId == myVolunteerId();
      allow update, delete: if false;
    }
