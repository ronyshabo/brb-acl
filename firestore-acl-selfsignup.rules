// ─────────────────────────────────────────────────────────────────────────────
// brb-acl — let volunteers add themselves to the roster.
//
// REPLACES the existing `match /aclVolunteers/{id}` block. Find that block
// between BEGIN brb-acl and END brb-acl and swap it for this one. Everything
// else stays as it is.
//
// What changed: `allow create` previously required isAclAdmin(). It now also
// permits a signed-in person to create THEIR OWN row — a document whose id is
// their own lowercased email, carrying their own uid. They cannot create a row
// for anyone else, cannot set themselves up as an admin (aclAdmins is still
// write-denied to every client), and cannot invent extra fields.
// ─────────────────────────────────────────────────────────────────────────────

    match /aclVolunteers/{id} {
      allow read: if isSignedIn();
      allow delete: if isAclAdmin();

      allow create: if isAclAdmin()
        || (id == myVolunteerId()
            && request.resource.data.email == id
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'active'
            && request.resource.data.keys().hasOnly([
                 'name', 'email', 'phone', 'status', 'uid',
                 'invitedAt', 'claimedAt', 'selfSignup', 'notes'
               ]));

      allow update: if isAclAdmin()
        // First-time uid link only, by the person whose email it is.
        // Check absence before value: reading a missing field errors, and an
        // erroring rule denies.
        || ((!('uid' in resource.data) || resource.data.uid == null)
            && id == myVolunteerId()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['uid', 'status', 'claimedAt']));
    }
